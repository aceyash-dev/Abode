<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Abode">

        <activity
            android:name="dev.abode.app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Chyme, in a window that floats over the keyboard. -->
        <activity
            android:name="dev.abode.app.ChymeActivity"
            android:exported="false"
            android:theme="@style/Theme.Abode.Floating" />

        <!-- Search, in a window that floats over the keyboard. -->
        <activity
            android:name="dev.abode.app.WebSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Abode.Floating" />

        <!--
            Transparent, zero-UI activity used to request RECORD_AUDIO.
            An InputMethodService cannot call requestPermissions(): it has no
            Activity to receive the result. The mic key launches this instead.
        -->
        <activity
            android:name="dev.abode.app.permission.MicrophonePermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Abode.Transparent" />

    </application>

</manifest>
