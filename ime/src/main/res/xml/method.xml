<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="dev.abode.app.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <!--
        One subtype per script. The Latin keyboard is the same in all three: the
        Devanagari subtypes transliterate as you type rather than showing a
        second layout, which is what people here already expect from a keyboard.
    -->
    <subtype
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_en" />

    <subtype
        android:imeSubtypeLocale="hi_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_hi" />

    <subtype
        android:imeSubtypeLocale="mr_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_mr" />

    <subtype
        android:imeSubtypeLocale="bho_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_bho" />

    <!--
        The rest of the Devanagari languages. They share the transliterator with
        Hindi and Marathi because they share the script, so each one is a label
        and a locale rather than an engine.
    -->
    <subtype
        android:imeSubtypeLocale="ne_NP"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_ne" />

    <subtype
        android:imeSubtypeLocale="mai_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_mai" />

    <subtype
        android:imeSubtypeLocale="sa_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_sa" />

    <subtype
        android:imeSubtypeLocale="kok_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_kok" />

    <subtype
        android:imeSubtypeLocale="doi_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_doi" />

    <!--
        Hinglish stays in Latin script, so it is not a transliterating subtype.
        The keyboard offers the Devanagari reading of the word you are typing as
        the first suggestion instead, and you take it or ignore it.
    -->
    <subtype
        android:imeSubtypeLocale="en_IN"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_hinglish" />

</input-method>
